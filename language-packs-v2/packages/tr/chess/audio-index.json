    },
    {
      "text": "Siyah At",
      "normalized": "siyah at",
      "file": "audio/8a9caaf9074cb1b3a0fac087.mp3"
    },
    {
      "text": "Siyah Fil",
      "normalized": "siyah fil",
      "file": "audio/6573ee950681545aefadf450.mp3"
    },
    {
      "text": "Siyah Kale",
      "normalized": "siyah kale",
      "file": "audio/e713fcf73a50cf4b67081300.mp3"
    },
    {
      "text": "Siyah Piyon",
      "normalized": "siyah piyon",
